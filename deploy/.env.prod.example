# Configuracion de PRODUCCION (servidor). Copiar a deploy/.env.prod y completar:
#   cp deploy/.env.prod.example deploy/.env.prod && nano deploy/.env.prod
# deploy/.env.prod NUNCA va a git (esta en .gitignore). Generar cada secreto con:
#   openssl rand -hex 32

# ---- Dominio y HTTPS ----
# Solo el dominio, sin https:// ni barra. El DNS (registro A) tiene que apuntar a este
# servidor ANTES de levantar Caddy, o Let's Encrypt no puede emitir el certificado.
APP_DOMAIN=certificado.ejemplo.com
# Correo para avisos de Let's Encrypt (vencimiento de certificados, etc.).
ACME_EMAIL=aaroncaldered@gmail.com

# ---- Base de datos (contenedor postgres, solo accesible en la red interna) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=certificado_transformacion

# ---- Secretos de la app ----
# Firma de las sesiones. Distinto al de desarrollo.
JWT_SECRET=
# Secreto del hash de cedulas (src/lib/identidad.ts). TAN CRITICO COMO LA BASE DE DATOS:
# si se pierde, los hashes nuevos ya no coinciden con los registrados on-chain. Guardar una
# copia fuera del servidor (gestor de contrasenas). Nunca rotarlo sin migrar.
IDENTITY_PEPPER=
# Correos que nacen como administradores de la app.
ADMIN_EMAILS=aaroncaldered@gmail.com

# ---- Cadena ----
NETWORK_NAME=amoy
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
INDEXER_CONFIRMATIONS=5
INDEXER_BLOCK_WINDOW=5000
# startBlock del deploy actual (packages/contracts/deployments/amoy.json)
INDEXER_START_BLOCK=52807377
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=54e4b818b1155ae665e2804d1d013d1d

# ---- Correo transaccional (elegir UNA opcion; ver docs/despliegue.md) ----
# smtp://usuario:clave@smtp.proveedor.com:587
SMTP_URL=
RESEND_API_KEY=
# Remitente con el dominio verificado en el proveedor de correo.
MAIL_FROM="Certificado de Transformacion <no-responder@certificado.ejemplo.com>"

LOG_LEVEL=info
