# Conexion a la instancia de PostgreSQL de ESTE proyecto (ver "npm run db:up" / scripts/db.mjs
# en la raiz del monorepo) -- puerto 5433 a proposito: DAPP Plastico Tesis usa 5432, en un
# proceso de PostgreSQL totalmente separado (no un contenedor compartido).
DATABASE_URL="postgresql://postgres:<password-de-.pgdata>@localhost:5433/certificado_transformacion?schema=public"

# Nombre del archivo de deployment a leer desde packages/contracts/deployments/{NETWORK_NAME}.json
# (y sus ABIs/direcciones exportadas). Default: "amoy". Usar "localhost" solo para probar
# contra un nodo local (`npx hardhat node`).
NETWORK_NAME=amoy

# RPC de Polygon Amoy usado por el indexer (puede ser el mismo que packages/contracts/.env)
AMOY_RPC_URL=

# Cuantas confirmaciones esperar antes de considerar un bloque "final" (mitiga reorgs)
INDEXER_CONFIRMATIONS=5

# Rango maximo de bloques por llamada eth_getLogs. 50 es el limite REAL medido en vivo para
# dRPC free tier con filtro de address -- su propio mensaje de error dice 10,000 pero eso no
# es cierto en la practica (ver sync.ts). Si cambias de RPC, volve a medirlo en vivo.
INDEXER_BLOCK_WINDOW=50

# Bloque desde el cual arrancar el backfill si IndexerState esta vacio.
# Usar el "startBlock" de packages/contracts/deployments/amoy.json -- IMPORTANTE: ese valor
# tiene que tomarse ANTES de la primera transaccion del deploy, no despues (ver el fix en
# scripts/deploy.ts y la seccion de bugs del README).
INDEXER_START_BLOCK=0

# Puerto distinto al 4000 de DAPP Plastico Tesis a proposito, para poder correr los dos
# proyectos al mismo tiempo sin que choquen.
PORT=4001

# Secreto para firmar/verificar tokens de sesion (login con email/contrasena).
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El frontend necesita EL MISMO valor en su .env.local (variable JWT_SECRET).
JWT_SECRET=
