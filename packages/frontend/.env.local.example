# WalletConnect Cloud project ID (gratis, cloud.walletconnect.com). Sin esto,
# RainbowKit sigue funcionando con wallets inyectadas (MetaMask) pero sin WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# URL base de la API REST (packages/backend) -- puerto 4001, no 4000 (ver nota de puertos en
# el README: evita chocar con DAPP Plastico Tesis si algun dia corren los dos a la vez)
NEXT_PUBLIC_API_URL=http://localhost:4001

# RPC de Polygon Amoy usado por el frontend (opcional; si se omite usa el publico de viem/chains)
NEXT_PUBLIC_AMOY_RPC_URL=

# Mismo valor que JWT_SECRET en packages/backend/.env -- SIN prefijo NEXT_PUBLIC_ a
# proposito (solo lo usa proxy.ts en el servidor, nunca debe llegar al navegador).
JWT_SECRET=
