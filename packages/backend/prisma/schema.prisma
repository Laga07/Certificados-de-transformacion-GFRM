// Prisma schema de DAPP Certificado de Transformacion: refleja las entidades y eventos
// emitidos por RegistroEntidades.sol, TokenCustodia.sol, CertificadoTransformacion.sol y
// MercadoCertificados.sol (packages/contracts/contracts/). Ver
// docs/arquitectura-certificado-transformacion.md para el diseno completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provincia {
  SanJose
  Alajuela
  Cartago
  Heredia
  Guanacaste
  Puntarenas
  Limon
}

// Coincide 1 a 1 con el enum Material de TiposComunes.sol -- append-only, nunca reordenar.
enum Material {
  Plastico
  CartonPapel
  Tetrapack
  Vidrio
  Metales
}

enum ModalidadEntrega {
  SinPago
  ConPago
  RutaMunicipal
}

enum QuienAbsorbe {
  Envia
  Recibe
  Mitad
}

enum EstadoTraspaso {
  Declarado
  Confirmado
}

/// Separador (mapping RegistroEntidades.separadores), poblado desde SeparadorRegistrado.
/// tipoSeparador es libre (sin enum on-chain) -- catalogo real en el frontend, igual que
/// tipoVivienda en DAPP Plastico Tesis (Hogar, Comercio, Industria, Institucion,
/// Recuperador Inclusivo).
model Separador {
  wallet        String    @id @db.VarChar(42)
  identidadHash String    @unique @db.VarChar(66)
  provincia     Provincia
  cantonId      Int
  tipoSeparador Int
  activo        Boolean   @default(true)
  registradoEn  DateTime
  blockNumber   BigInt
  txHash        String    @db.VarChar(66)
  createdAt     DateTime  @default(now())

  entregas Entrega[]
  aportes  EmisionAporte[]

  @@index([provincia, cantonId])
  @@map("separadores")
}

/// Intermediario (mapping RegistroEntidades.intermediarios). subtipo es libre (Recolector,
/// Centro de acopio, Municipalidad/ruta selectiva, Compactador, Transportista).
model Intermediario {
  wallet        String    @id @db.VarChar(42)
  nombreHash    String    @db.VarChar(66)
  cedulaHash    String    @unique @db.VarChar(66)
  provincia     Provincia
  cantonId      Int
  subtipo       Int
  verificado    Boolean   @default(false)
  verificadoEn  DateTime?
  verificadoPor String?   @db.VarChar(42)
  activo        Boolean   @default(true)
  registradoEn  DateTime
  blockNumber   BigInt
  txHash        String    @db.VarChar(66)
  createdAt     DateTime  @default(now())

  // Sin relaciones a Entrega.receptorWallet ni EmisionEslabon.direccion: esas direcciones
  // tambien pueden ser de un TRANSFORMADOR (entrega directa, o el propio transformador como
  // eslabon de su emision). Una FK a Intermediario rechazaba esas filas y trababa el indexer
  // (paso en el primer ciclo completo en produccion, 2026-11-25).

  @@index([verificado])
  @@index([provincia, cantonId])
  @@map("intermediarios")
}

/// Transformador (mapping RegistroEntidades.transformadores).
model Transformador {
  wallet        String    @id @db.VarChar(42)
  nombreHash    String    @db.VarChar(66)
  cedulaHash    String    @unique @db.VarChar(66)
  provincia     Provincia
  cantonId      Int
  verificado    Boolean   @default(false)
  verificadoEn  DateTime?
  verificadoPor String?   @db.VarChar(42)
  activo        Boolean   @default(true)
  registradoEn  DateTime
  blockNumber   BigInt
  txHash        String    @db.VarChar(66)
  createdAt     DateTime  @default(now())

  emisiones Emision[]

  @@index([verificado])
  @@map("transformadores")
}

/// Comprador (mapping RegistroEntidades.compradores). empresaObligadaLey9786 es
/// autodeclarado, solo para reporting/analitica -- no cambia el flujo del contrato.
model Comprador {
  wallet                 String   @id @db.VarChar(42)
  nombreHash              String   @db.VarChar(66)
  cedulaHash              String   @unique @db.VarChar(66)
  empresaObligadaLey9786  Boolean  @default(false)
  activo                  Boolean  @default(true)
  registradoEn            DateTime
  blockNumber             BigInt
  txHash                  String   @db.VarChar(66)
  createdAt               DateTime @default(now())

  ventas     VentaPrimaria[]
  retiros    CertificadoRetiro[]

  @@map("compradores")
}

/// Lote (mapping TokenCustodia.lotes) -- proyeccion que se actualiza en el lugar con cada
/// entrega/traspaso/union/division/consumo, igual que MunicipalBatch en DAPP Plastico Tesis.
/// El historial completo de como llego a su estado actual vive en Entrega/Traspaso/
/// LoteUnionEvento/LoteDivisionEvento, no aca.
model Lote {
  id                 BigInt   @id
  material           Material
  varianteId         Int
  custodioActual     String   @db.VarChar(42)
  pesoActual         Decimal  @db.Decimal(78, 0)
  pesoAceptadoOrigen Decimal  @db.Decimal(78, 0)
  activo             Boolean  @default(true)
  blockNumberCreado  BigInt
  txHashCreado       String   @db.VarChar(66)
  updatedAt          DateTime @updatedAt

  entregas          Entrega[]
  traspasos         Traspaso[]
  unionesComoNuevo  LoteUnionEvento[]   @relation("LoteUnionNuevo")
  divisionesComoOrigen LoteDivisionEvento[] @relation("LoteDivisionOrigen")

  @@index([material, activo])
  @@index([custodioActual])
  @@map("lotes")
}

/// Entrega (evento EntregaRegistrada) -- registro append-only de cada entrega individual,
/// sea a un lote nuevo o a uno existente.
model Entrega {
  id               Int              @id @default(autoincrement())
  loteId           BigInt
  separadorWallet  String           @db.VarChar(42)
  receptorWallet   String           @db.VarChar(42)
  material         Material
  varianteId       Int
  pesoGramos       Decimal          @db.Decimal(78, 0)
  modalidad        ModalidadEntrega
  precioUSDTporKg  Decimal          @db.Decimal(78, 0)
  blockNumber      BigInt
  txHash           String           @db.VarChar(66)
  logIndex         Int
  createdAt        DateTime         @default(now())

  lote      Lote           @relation(fields: [loteId], references: [id])
  separador Separador      @relation(fields: [separadorWallet], references: [wallet])
  // receptorWallet puede ser un intermediario O un transformador (entrega directa, "sin
  // intermediarios"): sin FK a proposito -- ver nota en el modelo Intermediario.

  @@unique([txHash, logIndex])
  @@index([loteId])
  @@index([separadorWallet])
  @@index([receptorWallet])
  @@map("entregas")
}

/// LoteUnido -- que lotes se fusionaron en cual. El linaje proporcional exacto (que % le
/// corresponde a cada separador/intermediario original) no se guarda on-chain -- se
/// reconstruye desde este evento + los aportes/merma que ya tenian los lotes de origen en el
/// momento de la union (consultables via Entrega/Traspaso de esos loteIds).
model LoteUnionEvento {
  id                 Int      @id @default(autoincrement())
  nuevoLoteId        BigInt
  loteIdsOrigen      Json // uint256[] como string[] (BigInt no es serializable directo a Json)
  pesosOrigen        Json // uint256[] como string[]
  varianteResultante Int
  blockNumber        BigInt
  txHash             String   @db.VarChar(66)
  logIndex           Int
  createdAt          DateTime @default(now())

  nuevoLote Lote @relation("LoteUnionNuevo", fields: [nuevoLoteId], references: [id])

  @@unique([txHash, logIndex])
  @@index([nuevoLoteId])
  @@map("lote_union_eventos")
}

/// LoteDividido -- un lote origen partido en N piezas nuevas.
model LoteDivisionEvento {
  id            Int      @id @default(autoincrement())
  loteIdOrigen  BigInt
  nuevosLoteIds Json // uint256[] como string[]
  pesos         Json // uint256[] como string[]
  blockNumber   BigInt
  txHash        String   @db.VarChar(66)
  logIndex      Int
  createdAt     DateTime @default(now())

  loteOrigen Lote @relation("LoteDivisionOrigen", fields: [loteIdOrigen], references: [id])

  @@unique([txHash, logIndex])
  @@index([loteIdOrigen])
  @@map("lote_division_eventos")
}

/// Traspaso en dos pasos (EnvioDeclarado + RecepcionConfirmada sobre el mismo loteId).
/// Se crea en "Declarado" y se completa a "Confirmado" cuando llega el segundo evento --
/// mismo patron de reconciliacion en dos fases que Transaccion/LoteTipoCierre en DAPP
/// Plastico Tesis.
model Traspaso {
  id                 Int             @id @default(autoincrement())
  loteId             BigInt
  de                 String          @db.VarChar(42)
  hacia               String          @db.VarChar(42)
  pesoEnviado        Decimal         @db.Decimal(78, 0)
  precioUSDTporKg    Decimal         @db.Decimal(78, 0)
  estado             EstadoTraspaso  @default(Declarado)
  pesoRecibido       Decimal?        @db.Decimal(78, 0)
  merma              Decimal?        @db.Decimal(78, 0)
  quienAbsorbe       QuienAbsorbe?
  blockNumberDeclarado  BigInt
  txHashDeclarado       String       @db.VarChar(66)
  blockNumberConfirmado BigInt?
  txHashConfirmado      String?      @db.VarChar(66)
  createdAt          DateTime        @default(now())

  lote Lote @relation(fields: [loteId], references: [id])

  @@index([loteId])
  @@index([de])
  @@index([hacia])
  @@index([estado])
  @@map("traspasos")
}

/// CertificadoContrato -- catalogo material -> direccion del clon ERC20 desplegado (evento
/// CertificadoDesplegado en MercadoCertificados).
model CertificadoContrato {
  material    Material @id
  direccion   String   @db.VarChar(42)
  nombre      String
  simbolo     String
  blockNumber BigInt
  txHash      String   @db.VarChar(66)
  createdAt   DateTime @default(now())

  @@map("certificado_contratos")
}

/// Emision (evento TransformacionRegistrada) -- el "LoteDeEmision" del documento de
/// arquitectura: snapshot inmutable tomado al transformar. kgDisponiblesPrimario se
/// actualiza con cada venta primaria parcial (igual que pesoOficialGramos en
/// MunicipalBatch).
model Emision {
  id                      BigInt   @id
  material                Material
  transformadorWallet     String   @db.VarChar(42)
  loteConsolidadoId       BigInt
  pesoConsumidoTotal      Decimal  @db.Decimal(78, 0)
  kgTransformadosOriginal Decimal  @db.Decimal(78, 0)
  kgDisponiblesPrimario   Decimal  @db.Decimal(78, 0)
  pesoAceptadoOrigenTotal Decimal  @db.Decimal(78, 0)
  mermaTransformador      Decimal  @db.Decimal(78, 0)
  precioUSDTporKg         Decimal  @db.Decimal(78, 0)
  blockNumber             BigInt
  txHash                  String   @db.VarChar(66)
  createdAt               DateTime @default(now())

  transformador Transformador    @relation(fields: [transformadorWallet], references: [wallet])
  aportes       EmisionAporte[]
  eslabones     EmisionEslabon[]
  ventas        VentaPrimaria[]

  @@index([transformadorWallet])
  @@index([material])
  @@map("emisiones")
}

/// Aporte de cada separador a una emision (copiado desde TokenCustodia.aportesDeLote en el
/// momento de registrarTransformacion) -- base para calcular su parte de cada venta.
model EmisionAporte {
  id              Int     @id @default(autoincrement())
  emisionId       BigInt
  separadorWallet String  @db.VarChar(42)
  kgAportado      Decimal @db.Decimal(78, 0)

  emision   Emision   @relation(fields: [emisionId], references: [id])
  separador Separador @relation(fields: [separadorWallet], references: [wallet])

  @@unique([emisionId, separadorWallet])
  @@index([separadorWallet])
  @@map("emision_aportes")
}

/// Eslabon (intermediario o el transformador) de una emision, con su merma atribuida --
/// copiado desde TokenCustodia.mermaDeLote mas la merma propia de la transformacion.
model EmisionEslabon {
  id         Int     @id @default(autoincrement())
  emisionId  BigInt
  direccion  String  @db.VarChar(42)
  mermaKg    Decimal @db.Decimal(78, 0)

  emision       Emision        @relation(fields: [emisionId], references: [id])
  // direccion puede ser un intermediario o el transformador: sin FK a proposito.

  @@unique([emisionId, direccion])
  @@index([direccion])
  @@map("emision_eslabones")
}

/// Venta primaria (evento CertificadoComprado) -- cada compra (total o parcial) de una
/// emision.
model VentaPrimaria {
  id              Int      @id @default(autoincrement())
  emisionId       BigInt
  compradorWallet String   @db.VarChar(42)
  cantidadKg      Decimal  @db.Decimal(78, 0)
  valorTotal      Decimal  @db.Decimal(78, 0)
  blockNumber     BigInt
  txHash          String   @db.VarChar(66)
  logIndex        Int
  createdAt       DateTime @default(now())

  emision   Emision   @relation(fields: [emisionId], references: [id])
  comprador Comprador @relation(fields: [compradorWallet], references: [wallet])
  pagos     PagoAcreditado[]

  @@unique([txHash, logIndex])
  @@index([emisionId])
  @@index([compradorWallet])
  @@map("ventas_primarias")
}

/// Pago acreditado a un destinatario por una venta (evento PagoAcreditado) -- el detalle
/// linea por linea del reparto 35/20/30/15 + cascada de merma de cada venta. saldoPendiente
/// en si no se duplica en la base de datos: se lee en vivo del contrato (mismo patron que
/// las lecturas de rol en DAPP Plastico Tesis), esta tabla es el historial de como se
/// compuso cada acreditacion.
model PagoAcreditado {
  id            Int      @id @default(autoincrement())
  ventaId       Int?
  emisionId     BigInt
  destinatario  String   @db.VarChar(42)
  monto         Decimal  @db.Decimal(78, 0)
  blockNumber   BigInt
  txHash        String   @db.VarChar(66)
  logIndex      Int
  createdAt     DateTime @default(now())

  venta VentaPrimaria? @relation(fields: [ventaId], references: [id])

  @@unique([txHash, logIndex])
  @@index([destinatario])
  @@index([emisionId])
  @@map("pagos_acreditados")
}

/// Retiro de un saldo pendiente (evento PagoRetirado) -- permissionless, lo puede disparar
/// cualquiera a nombre del destinatario.
model PagoRetiro {
  id           Int      @id @default(autoincrement())
  destinatario String   @db.VarChar(42)
  monto        Decimal  @db.Decimal(78, 0)
  blockNumber  BigInt
  txHash       String   @db.VarChar(66)
  logIndex     Int
  createdAt    DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([destinatario])
  @@map("pagos_retiros")
}

/// Retiro de certificado para uso en un informe de cumplimiento (evento
/// CertificadoRetirado) -- quema permanente, queda registrado quien lo uso, en que informe
/// y para que periodo.
model CertificadoRetiro {
  id              Int      @id @default(autoincrement())
  compradorWallet String   @db.VarChar(42)
  material        Material
  cantidadKg      Decimal  @db.Decimal(78, 0)
  informeRef      String   @db.VarChar(66)
  periodo         Int
  blockNumber     BigInt
  txHash          String   @db.VarChar(66)
  logIndex        Int
  createdAt       DateTime @default(now())

  comprador Comprador @relation(fields: [compradorWallet], references: [wallet])

  @@unique([txHash, logIndex])
  @@index([compradorWallet])
  @@index([material])
  @@map("certificado_retiros")
}

/// Ingesta cruda de eventos: resiliencia ante crashes/reorgs del indexer. Cada log se
/// guarda aqui antes de aplicar su handler especifico.
model RawEvent {
  id              Int      @id @default(autoincrement())
  contractAddress String   @db.VarChar(42)
  eventName       String
  blockNumber     BigInt
  blockHash       String   @db.VarChar(66)
  txHash          String   @db.VarChar(66)
  logIndex        Int
  args            Json
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([processed])
  @@map("raw_events")
}

/// Estado de indexacion por chain: ultimo bloque procesado, usado para el backfill y para
/// detectar reorgs comparando lastBlockHash contra la cadena real.
model IndexerState {
  id              Int      @id @default(1)
  chainId         Int      @unique
  lastBlockNumber BigInt
  lastBlockHash   String   @db.VarChar(66)
  updatedAt       DateTime @updatedAt

  @@map("indexer_state")
}

// ==== CUENTAS, PERFILES OFF-CHAIN Y DOCUMENTOS (plan de produccion, B3/B4/B5) ====
// Nada de esto viene de la cadena: es el lado "humano" del sistema -- quien es la persona o
// empresa detras de cada wallet, con que correo entra, y los documentos que el verificador
// revisa antes de aprobar on-chain a un intermediario o transformador.

enum AccountRol {
  USER
  ADMIN
}

enum TipoAuthToken {
  VERIFICAR_EMAIL
  RESET_PASSWORD
}

enum TipoEntidad {
  SEPARADOR
  INTERMEDIARIO
  TRANSFORMADOR
  COMPRADOR
}

enum EstadoRevision {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Cuenta de acceso a la aplicacion (email/contrasena). `rol` controla el acceso al panel de
/// administracion de la app (distinto de VERIFIER_ROLE on-chain, que vive en la wallet).
/// `walletAddress` se vincula firmando un mensaje con la wallet (ver routes/auth.ts) -- es la
/// unica forma de saber que persona esta detras de que direccion.
model Account {
  id                Int        @id @default(autoincrement())
  email             String     @unique @db.VarChar(255)
  passwordHash      String
  rol               AccountRol @default(USER)
  emailVerificadoEn DateTime?
  walletAddress     String?    @unique @db.VarChar(42)
  walletVinculadaEn DateTime?
  walletNonce       String?    @db.VarChar(64)
  intentosFallidos  Int        @default(0)
  bloqueadoHasta    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  tokens        AuthToken[]
  perfil        EntidadPerfil?
  declaraciones Declaracion[]

  @@map("accounts")
}

/// Tokens de un solo uso para verificar el correo y restablecer la contrasena. Se guarda el
/// SHA-256 del token, nunca el token en claro (igual que una contrasena).
model AuthToken {
  id        Int           @id @default(autoincrement())
  accountId Int
  tipo      TipoAuthToken
  tokenHash String        @unique @db.VarChar(64)
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime      @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, tipo])
  @@map("auth_tokens")
}

/// Datos en claro de la entidad detras de una wallet. On-chain solo viaja el hash de la
/// cedula y el nombre; aca vive lo que el verificador necesita para saber a quien esta
/// aprobando (razon social, cedula, contacto, documentos). Solo lo ven el dueno y los admins.
model EntidadPerfil {
  id              Int            @id @default(autoincrement())
  accountId       Int            @unique
  tipo            TipoEntidad
  razonSocial     String         @db.VarChar(200)
  cedula          String         @db.VarChar(40)
  /// Hash HMAC (con pepper del servidor) de la cedula normalizada -- el mismo valor que se
  /// manda al contrato, para poder cruzar perfil <-> registro on-chain sin exponer la cedula.
  cedulaHash      String         @db.VarChar(66)
  representante   String?        @db.VarChar(200)
  telefono        String?        @db.VarChar(40)
  correoContacto  String?        @db.VarChar(255)
  direccion       String?        @db.VarChar(500)
  provincia       Provincia
  cantonId        Int
  subtipo         Int?
  descripcion     String?        @db.VarChar(2000)
  estadoRevision  EstadoRevision @default(PENDIENTE)
  notasRevisor    String?        @db.VarChar(2000)
  revisadoPorId   Int?
  revisadoEn      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documentos PerfilDocumento[]

  @@index([estadoRevision, tipo])
  @@index([cedulaHash])
  @@map("entidad_perfiles")
}

/// Archivo adjunto a un perfil (cedula juridica, personeria, permiso sanitario, etc.). El
/// binario vive fuera de la DB (UPLOADS_DIR local hoy; R2/S3 en produccion), aca solo la
/// referencia.
model PerfilDocumento {
  id         Int      @id @default(autoincrement())
  perfilId   Int
  nombre     String   @db.VarChar(255)
  mimeType   String   @db.VarChar(100)
  tamano     Int
  storageKey String   @unique @db.VarChar(500)
  createdAt  DateTime @default(now())

  perfil EntidadPerfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@index([perfilId])
  @@map("perfil_documentos")
}

// ==== DECLARACIONES DE CUMPLIMIENTO (retiro de certificados) ====

enum EstadoDeclaracion {
  PENDIENTE
  CONFIRMADA
}

/// Declaracion de cumplimiento: el comprador "retira" (quema) certificados para respaldar un
/// informe ante una entidad (p. ej. Ministerio de Salud, Ley 9786) y un periodo.
///
/// Flujo: 1) se crea PENDIENTE con los datos de la declaracion; `contenido` es su JSON
/// canonico y `informeRef` = keccak256(contenido). 2) el comprador llama
/// MercadoCertificados.retirarCertificado(material, kg, informeRef, periodo): la huella queda
/// grabada on-chain en el evento CertificadoRetirado. 3) pasa a CONFIRMADA al verificar ese
/// evento (endpoint /confirmar o el indexer, lo que llegue primero).
///
/// Cualquiera puede verificar una constancia en /verificar/<codigo>: recalcula keccak256 del
/// contenido publicado y lo compara con el informeRef del evento on-chain.
model Declaracion {
  id             Int               @id @default(autoincrement())
  /// Codigo publico corto y aleatorio (no secuencial, para que no se puedan enumerar).
  codigo         String            @unique @db.VarChar(16)
  accountId      Int
  wallet         String            @db.VarChar(42)
  material       Material
  cantidadKg     Decimal           @db.Decimal(78, 0)
  /// Codificado AAAA*100 + NN: 00 anual, 01-12 mes, 21-24 trimestre, 31-32 semestre.
  periodo        Int
  periodoTexto   String            @db.VarChar(40)
  entidadDestino String            @db.VarChar(200)
  referencia     String?           @db.VarChar(120)
  descripcion    String?           @db.VarChar(1000)
  /// Snapshot del perfil de la entidad al momento de declarar.
  razonSocial    String?           @db.VarChar(200)
  cedulaJuridica String?           @db.VarChar(40)
  contenido      String
  informeRef     String            @unique @db.VarChar(66)
  estado         EstadoDeclaracion @default(PENDIENTE)
  txHash         String?           @unique @db.VarChar(66)
  blockNumber    BigInt?
  confirmadaEn   DateTime?
  createdAt      DateTime          @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([wallet, material, estado])
  @@map("declaraciones")
}
